# Docker Environment Variables
# Copy this file to .env and configure your values

# PostgreSQL Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here

# AI Provider API Keys
# Option 1: Use Vercel AI Gateway (Recommended)
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here

# Option 2: Direct API Keys (if not using AI Gateway)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OCR Language Configuration
# Supported: eng, chi_sim, chi_tra, spa, fra, deu, etc.
# Multiple languages: eng+chi_sim
OCR_LANGUAGES=eng

# Optional: Database tuning for production
# POSTGRES_MAX_CONNECTIONS=100
# POSTGRES_SHARED_BUFFERS=256MB
