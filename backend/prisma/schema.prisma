// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Exam {
  id        Int        @id @default(autoincrement())
  url       String
  name      String     @default("")
  subject   String
  parsed    Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  questions Question[]
  answers   Answer[]
}

model Question {
  id         Int       @id @default(autoincrement())
  examId     Int
  number     Int
  part       String?
  text       String    @db.Text
  type       String    // "MCQ" or "Open-ended"
  image      String[]  @default([])
  pageNumber Int?      // Page number where this question appears in the PDF
  options    String[]  @default([])
  exam       Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers    Answer[]

  @@index([examId])
}

model Answer {
  id                 Int      @id @default(autoincrement())
  examId             Int
  questionId         Int
  textFromPdf        String?  @db.Text // Optional: Answer extracted from the PDF
  textFromAi         String   @db.Text // Compulsory: Answer generated by AI
  isAiGenerated      Boolean  @default(false) // Indicates if answer was generated by AI vs from original PDF
  isVerified         Boolean  @default(false) // Indicates if answer was verified by AI
  verificationNote   String?  @db.Text // AI verification note (e.g., "Answer may be incorrect due to low quality scan")
  aiSuggestedAnswer  String?  @db.Text // AI-suggested alternative answer if verification fails
  createdAt          DateTime @default(now())
  exam               Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([questionId])
}
